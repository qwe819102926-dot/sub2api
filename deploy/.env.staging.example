# =============================================================================
# Sub2API Staging Container Environment (.env.staging)
# =============================================================================
# Copy this file to .env.staging and modify as needed:
#   cp deploy/.env.staging.example .env.staging
#   chmod 600 .env.staging
#   nano .env.staging
#
# Then start the staging instance:
#   docker compose \
#     -f docker-compose.staging.yml \
#     --env-file .env.staging \
#     up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Staging instance port (inside the container the app still listens on 8080;
# the host port is mapped by STAGING_SERVER_PORT)
# -----------------------------------------------------------------------------
# Bind to 127.0.0.1 so the instance is only reachable via the reverse proxy
# (Caddy/Nginx) on the server, not directly exposed to the internet.
STAGING_BIND_HOST=127.0.0.1
STAGING_SERVER_PORT=8081

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_MODE=release
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ENV=staging
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# Database (separate instance from production)
# -----------------------------------------------------------------------------
POSTGRES_DB=sub2api_staging
# REQUIRED: Set a strong password unique to the staging environment
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Redis (separate instance from production)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Admin account (auto-created on first run, for the staging instance)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin-staging@aitokey.top
# REQUIRED: Set a strong password
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# JWT Secret (REQUIRED — generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
JWT_SECRET=

# -----------------------------------------------------------------------------
# The rest of the variables work the same as .env.example.
# Copy the values you need from there, or let the defaults inside
# docker-compose.staging.yml apply.
# -----------------------------------------------------------------------------
# UPDATE_GITHUB_TOKEN, ENABLE_SERVER_TIMING, etc.