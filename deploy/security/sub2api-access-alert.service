[Unit]
Description=Sub2API access security alerts (no automatic blocking)
After=caddy.service

[Service]
Type=oneshot
User=caddy
Group=caddy
UMask=0027
ExecStart=/usr/bin/python3 /usr/local/lib/sub2api-security/access_alert.py
StateDirectory=sub2api-access-alert
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/log/caddy
TimeoutStartSec=45
MemoryMax=128M
CPUQuota=10%
SyslogLevel=warning
